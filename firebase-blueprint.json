{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the system with specific roles.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "staff"],
          "description": "The user's role in the system."
        },
        "uid": {
          "type": "string",
          "description": "The Firebase Auth UID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the user record was created."
        }
      },
      "required": ["email", "role", "uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles and roles."
    }
  }
}
